{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "db:init:local": "wrangler d1 execute DB --local --config wrangler.jsonc --file init.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@opennextjs/cloudflare": "^1.20.11",
    "@tabler/icons-react": "^2.47.0",
    "chart.js": "^4.4.0",
    "chartjs-adapter-moment": "^1.0.1",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "moment": "^2.29.4",
    "moment-precise-range-plugin": "^1.3.0",
    "next": "16.3.8",
    "p-limit": "^7.2.0",
    "react": "^19.2.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.0"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20250508.0",
    "@types/moment-precise-range-plugin": "^0.2.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.8.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
